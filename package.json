{
  "name": "@slothkit/eslint-config",
  "version": "2.0.0",
  "description": "eslint shareable configs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./typescript": "./typescript.js",
    "./rules/react": "./rules/react.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/slothkit/eslint-config.git"
  },
  "keywords": [
    "slothkit",
    "eslint",
    "airbnb"
  ],
  "author": "MichaelTZ",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/slothkit/eslint-config/issues"
  },
  "homepage": "https://github.com/slothkit/eslint-config#readme",
  "scripts": {
    "commit": "git add . && cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "test": "eslint --report-unused-disable-directives ."
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "*"
  },
  "devDependencies": {
    "commitizen": "^4.3.0",
    "conventional-changelog-cli": "^2.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "typescript": "^5.0.3"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "confusing-browser-globals": "^1.0.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
